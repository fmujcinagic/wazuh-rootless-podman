[Unit]
Description=Wazuh indexer
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=wazuh.indexer
Image={{ wazuh_indexer_image }}
HostName=wazuh.indexer
Network=wazuh.network
PodmanArgs=--network-alias=wazuh.indexer
PublishPort={{ wazuh_indexer_port }}:9200
Environment="OPENSEARCH_JAVA_OPTS=-Xms{{ wazuh_indexer_heap }} -Xmx{{ wazuh_indexer_heap }}"
Volume=wazuh-indexer-data:/var/lib/wazuh-indexer
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/config/certs/root-ca.pem:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/wazuh.indexer-key.pem:/usr/share/wazuh-indexer/config/certs/wazuh.indexer.key:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/wazuh.indexer.pem:/usr/share/wazuh-indexer/config/certs/wazuh.indexer.pem:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/admin.pem:/usr/share/wazuh-indexer/config/certs/admin.pem:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/admin-key.pem:/usr/share/wazuh-indexer/config/certs/admin-key.pem:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer/wazuh.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml:ro
Volume={{ wazuh_config_dir }}/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml:ro

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
