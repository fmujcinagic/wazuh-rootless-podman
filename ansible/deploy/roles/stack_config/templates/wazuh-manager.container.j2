[Unit]
Description=Wazuh manager
After=network-online.target{% if wazuh_node_role == 'master' %} wazuh-indexer.service{% endif %}
Wants=network-online.target
{% if wazuh_node_role == 'master' %}
Requires=wazuh-indexer.service
{% endif %}

[Container]
ContainerName=wazuh.manager
Image={{ wazuh_manager_image }}
HostName=wazuh.manager
Network=wazuh.network
PodmanArgs=--network-alias=wazuh.manager --security-opt label=level:s0
PublishPort={{ wazuh_agent_events_port }}:1514
PublishPort={{ wazuh_agent_enrollment_port }}:1515
PublishPort={{ wazuh_api_port }}:55000
{% if wazuh_cluster_enabled %}
PublishPort={{ wazuh_cluster_port }}:{{ wazuh_cluster_port }}
{% endif %}
PublishPort={{ wazuh_syslog_port }}:514/udp
Environment=INDEXER_URL={{ wazuh_manager_indexer_url }}
Environment=INDEXER_USERNAME=admin
Environment=FILEBEAT_SSL_VERIFICATION_MODE={{ wazuh_filebeat_ssl_verification_mode }}
Environment=SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
Environment=SSL_CERTIFICATE=/etc/ssl/filebeat.pem
Environment=SSL_KEY=/etc/ssl/filebeat.key
Environment=API_USERNAME=wazuh-wui
Secret=INDEXER_PASSWORD,type=env
Secret=API_PASSWORD,type=env
Volume=wazuh_api_configuration:/var/ossec/api/configuration:z
Volume=wazuh_etc:/var/ossec/etc:z
Volume=wazuh_logs:/var/ossec/logs:z
Volume=wazuh_queue:/var/ossec/queue:z
Volume=wazuh_integrations:/var/ossec/integrations:z
Volume=wazuh_active_response:/var/ossec/active-response/bin:z
Volume=wazuh_wodles:/var/ossec/wodles:z
Volume=filebeat_etc:/etc/filebeat:z
Volume=filebeat_var:/var/lib/filebeat:z
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem:ro,z
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/wazuh.manager.pem:/etc/ssl/filebeat.pem:ro,z
Volume={{ wazuh_config_dir }}/wazuh_indexer_ssl_certs/wazuh.manager-key.pem:/etc/ssl/filebeat.key:ro,z
Volume={{ wazuh_config_dir }}/wazuh_cluster/wazuh_manager.conf:/wazuh-config-mount/etc/ossec.conf:ro,z

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
