# Generated by build-bundle.yml, do not edit.
wazuh_version: "{{ wazuh_version }}"
images:
{% for ref in bundle_images %}
{% set fname = ref | relpath('docker.io') | replace('/', '-') | replace(':', '-') + '.tar' %}
{% set entry = bundle_files.results
    | selectattr('stat.path', 'search', (fname | regex_escape))
    | map(attribute='stat.checksum') | first %}
  - ref: "{{ ref }}"
    path: "images/{{ fname }}"
    sha256: "{{ entry }}"
{% endfor %}
files:
{% for f in bundle_files.results %}
{% if not (f.stat.path | basename).endswith('.tar') %}
  - path: "{{ f.stat.path | relpath(bundle_out_dir) }}"
    sha256: "{{ f.stat.checksum }}"
    size: {{ f.stat.size }}
{% endif %}
{% endfor %}
